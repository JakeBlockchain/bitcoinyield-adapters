# ============================================================================
# @bitcoinyield/adapters — example environment
# ============================================================================
#
# Copy this file to .env.local (which is gitignored) and fill in the values
# for whichever adapters you want to test locally:
#
#   cp .env.example .env.local
#
# The CLI auto-loads .env.local on every invocation. Adapters that don't
# need credentials work without any env setup.
#
# All variables are namespaced with BITCOINYIELD_* to avoid colliding with
# other env vars on your machine.
# ============================================================================


# ----------------------------------------------------------------------------
# Microservice runtime — only needed when running `pnpm dev` / `pnpm start`
# or deploying via Vercel. The CLI works without these.
# ----------------------------------------------------------------------------

# Inngest credentials (production).
# Get from https://app.inngest.com → Manage → Event keys / Signing key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Main BitcoinYield app — where adapter results are POSTed.
# Used by:  HttpStorage (src/core/storage/http.ts)
# Endpoints called:
#   GET  $BITCOINYIELD_API_URL/api/adapter-metrics/:slug/latest
#   POST $BITCOINYIELD_API_URL/api/adapter-metrics
#   POST $BITCOINYIELD_API_URL/api/adapter-status
# Required when BITCOINYIELD_STORAGE_MODE is unset / not "log".
BITCOINYIELD_API_URL=http://localhost:3000/
BITCOINYIELD_ADAPTER_KEY=

# Storage mode switch. Set to `log` to write adapter results to stdout
# (LoggingStorage) instead of POSTing to the main app. Used for testing the
# Vercel deploy before the main-app endpoints are live — every run prints
# `[adapter-metrics]` and `[adapter-status]` lines that are grep-able in
# Vercel logs. Unset (or any other value) uses HttpStorage and requires
# BITCOINYIELD_API_URL + BITCOINYIELD_ADAPTER_KEY above.
# BITCOINYIELD_STORAGE_MODE=log

# Discord webhook for operational paging. Optional — DiscordNotifier silently
# no-ops if unset. Every alert (spike, boundary, staleness, regression)
# routes here; the message itself encodes the alert type, so a single
# channel is enough.
DISCORD_WEBHOOK=


# ----------------------------------------------------------------------------
# Toolbox utilities — used by the framework's shared helpers
# ----------------------------------------------------------------------------

# Ethereum mainnet RPC endpoint.
# Used by:  ethereum.readContract / ethereum.multicall
# Adapters: lombard-finance, acre-mezo, morpho-gauntlet, and the six yb-*
#           Yield Basis adapters
# Default:  Public RPC fallbacks (Cloudflare, llamarpc, ankr, publicnode).
#           Works but slower and rate-limited, and the historical (archive)
#           reads used for APR often fail. In production use a dedicated
#           QuickNode / Alchemy endpoint.
# Get one: https://alchemy.com or https://quicknode.com (free tier is plenty)
BITCOINYIELD_RPC_ETHEREUM=

# Botanix L2 RPC endpoint (chain id 3637).
# Used by:  getEvmClient — adapters/botanix
# Default:  Public fallbacks (ankr, thirdweb, botanixlabs). Same archive-read
#           caveat as above: set a dedicated endpoint in production.
BITCOINYIELD_RPC_BOTANIX=

# Ink L2 RPC endpoint (chain id 57073 — Kraken's chain).
# Used by:  getEvmClient — adapters/kraken-bitcoin-earn
# Default:  Public fallbacks (rpc-gel.inkonchain.com, drpc). The 30d APY
#           needs an archive read; without one the run fails.
BITCOINYIELD_RPC_INK=

# Base RPC endpoint (chain id 8453 — Syntetika's hBTC vault).
# Used by:  getEvmClient — adapters/syntetika-hbtc
# Default:  Public fallbacks (mainnet.base.org, drpc, publicnode). The 30d
#           APY needs an archive read; without one the run fails.
BITCOINYIELD_RPC_BASE=

# Browserbase credentials for the scraper utility.
# Used by:  scraper.scrape / scraper.openPage
# Adapters: mezo-earn, merlin-btc — the only two adapters with no known
#           on-chain or API source. Everything else is contract/API-first.
# Default:  None — these adapters will throw without credentials.
# Get one:  https://browserbase.com (sign-up gives you a free trial credit)
BITCOINYIELD_BROWSERBASE_KEY=
BITCOINYIELD_BROWSERBASE_PROJECT_ID=

# Stacks API base URL override (uncommon).
# Used by:  stacks.getFungibleTokenBalance / stacks.callReadOnly
# Adapters: zest-protocol (and any future Stacks-based adapter)
# Default:  https://api.hiro.so — the public Hiro API. Works without a key.
# BITCOINYIELD_STACKS_API=https://api.hiro.so


# ----------------------------------------------------------------------------
# Per-adapter secrets — declared in adapter.requires.secrets
# ----------------------------------------------------------------------------

# Amboss GraphQL API key.
# Adapter:  amboss
# Default:  None — adapter will throw without it.
# How:      Get from your Amboss account settings, or ask the BitcoinYield
#           team for the production value.
BITCOINYIELD_AMBOSS_API_KEY=
# Voyager (Starknet) API key.
# Adapter:  starknet
# Default:  None — adapter will throw without it.
# How:      https://voyager.online/api → API key signup, or ask the
#           BitcoinYield team for the production value.
BITCOINYIELD_VOYAGER_API_KEY=
